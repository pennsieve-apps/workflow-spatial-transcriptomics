{
  "name": "Cell-type Deconvolution & Niches",
  "summary": "Visium + scRNA-seq reference: cell2location abundances per spot, co-location groups, niches.",
  "description": "Estimates the cell-type composition of every Visium spot from a single-cell reference and maps how cell types organize in the tissue. Reads Space Ranger or AnnData input (st-prep), filters and normalizes spots (st-qc), runs cell2location (Kleshchevnikov et al. 2022) with reference signatures estimated from the scRNA-seq reference, reports per-spot cell abundances, the dominant type per spot and co-location groups, scores neighbourhood enrichment and cellular niches of each spot's strongest co-location group (squidpy), and writes an HTML report with tables. Runs cell2location's CPU variant (5,000 epochs); use the GPU workflow where a GPU node is available.",
  "inputs": [
    {
      "id": "spatial",
      "name": "Spatial transcriptomics data",
      "description": "A folder of Space Ranger outputs (one per sample) or AnnData .h5ad files, plus an optional samples.csv.",
      "position": {
        "x": 40,
        "y": 170
      }
    },
    {
      "id": "reference",
      "name": "scRNA-seq reference",
      "description": "An AnnData .h5ad of single-cell RNA-seq from the same tissue: raw counts, a cell-type column (CELL_TYPE_COLUMN, default cell_type), gene symbols.",
      "position": {
        "x": 40,
        "y": 430
      }
    }
  ],
  "processors": [
    {
      "id": "prep",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/st-prep",
      "tag": "v0.1.1",
      "dependsOn": [
        "spatial"
      ],
      "position": {
        "x": 300,
        "y": 300
      },
      "cpu": "2048",
      "memory": "8192"
    },
    {
      "id": "qc",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/st-qc",
      "tag": "v0.1.0",
      "dependsOn": [
        "prep"
      ],
      "position": {
        "x": 560,
        "y": 300
      },
      "cpu": "2048",
      "memory": "16384",
      "inputs": [
        {
          "from": "prep",
          "output": "spatial",
          "input": "spatial"
        },
        {
          "from": "prep",
          "output": "metadata",
          "input": "metadata"
        }
      ]
    },
    {
      "id": "deconvolution",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/cell2location",
      "tag": "v0.1.0",
      "dependsOn": [
        "qc",
        "prep",
        "reference"
      ],
      "position": {
        "x": 820,
        "y": 300
      },
      "cpu": "4096",
      "memory": "16384",
      "inputs": [
        {
          "from": "qc",
          "output": "spatial",
          "input": "spatial"
        },
        {
          "from": "prep",
          "output": "metadata",
          "input": "metadata"
        },
        {
          "from": "reference",
          "input": "reference"
        }
      ],
      "defaultParams": {
        "CELL_TYPE_COLUMN": "cell_type"
      }
    },
    {
      "id": "niches",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/st-niches",
      "tag": "v0.1.0",
      "dependsOn": [
        "deconvolution",
        "qc",
        "prep"
      ],
      "position": {
        "x": 1080,
        "y": 300
      },
      "cpu": "2048",
      "memory": "6144",
      "inputs": [
        {
          "from": "qc",
          "output": "spatial",
          "input": "spatial"
        },
        {
          "from": "deconvolution",
          "output": "labels",
          "input": "labels"
        },
        {
          "from": "prep",
          "output": "metadata",
          "input": "metadata"
        }
      ],
      "defaultParams": {
        "LABEL_COLUMN": "colocation_group",
        "LABEL": "colocation-group"
      }
    },
    {
      "id": "report",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/st-report",
      "tag": "v0.1.0",
      "dependsOn": [
        "prep",
        "qc",
        "deconvolution",
        "niches"
      ],
      "position": {
        "x": 1340,
        "y": 300
      },
      "cpu": "1024",
      "memory": "2048",
      "inputs": [
        {
          "from": "prep",
          "output": "metadata",
          "input": "metadata"
        },
        {
          "from": "qc",
          "output": "qc",
          "input": "qc"
        },
        {
          "from": "deconvolution",
          "output": "labels",
          "input": "deconvolution"
        },
        {
          "from": "niches",
          "output": "niches",
          "input": "niches"
        }
      ],
      "defaultParams": {
        "REPORT_TITLE": "Cell-type Deconvolution & Niches"
      }
    }
  ],
  "outputs": [
    {
      "id": "report_out",
      "name": "Report",
      "from": {
        "step": "report",
        "output": "report"
      },
      "position": {
        "x": 1600,
        "y": 170
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/deconvolution/report"
        }
      }
    },
    {
      "id": "tables_out",
      "name": "Tables",
      "from": {
        "step": "report",
        "output": "tables"
      },
      "position": {
        "x": 1600,
        "y": 300
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/deconvolution/tables"
        }
      }
    },
    {
      "id": "abundance_out",
      "name": "Cell-type abundances",
      "from": {
        "step": "deconvolution",
        "output": "labels"
      },
      "position": {
        "x": 1600,
        "y": 430
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/deconvolution/cell2location"
        }
      }
    },
    {
      "id": "model_out",
      "name": "Reference signatures & model",
      "from": {
        "step": "deconvolution",
        "output": "model"
      },
      "position": {
        "x": 1600,
        "y": 560
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/deconvolution/model"
        }
      }
    },
    {
      "id": "niches_out",
      "name": "Niches",
      "from": {
        "step": "niches",
        "output": "niches"
      },
      "position": {
        "x": 1600,
        "y": 690
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/deconvolution/niches"
        }
      }
    }
  ]
}
