{
  "name": "Single-cell Spatial Profiling",
  "summary": "Xenium/MERSCOPE/CosMx: QC, clustering and cell typing, niches, ligand-receptor signalling.",
  "description": "Profiles imaging-based single-cell spatial transcriptomics (10x Xenium, Vizgen MERSCOPE, NanoString CosMx). Reads the platform's cell-by-gene output (st-prep), filters and normalizes cells (st-qc), clusters cells across samples and labels them from canonical or user-supplied marker sets (st-celltype), scores neighbourhood enrichment, co-occurrence and cellular niches (st-niches, squidpy), infers ligand-receptor communication between cell types and in space with LIANA+ (st-ccc), and writes an HTML report with tables.",
  "inputs": [
    {
      "id": "spatial",
      "name": "Spatial transcriptomics data",
      "description": "A folder with one Xenium, MERSCOPE or CosMx output folder per sample (cell-by-gene matrix and cell metadata), or AnnData .h5ad / SpatialData .zarr files, plus an optional samples.csv and markers.csv.",
      "position": {
        "x": 40,
        "y": 300
      }
    }
  ],
  "processors": [
    {
      "id": "prep",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/st-prep",
      "tag": "v0.1.1",
      "dependsOn": [
        "spatial"
      ],
      "position": {
        "x": 300,
        "y": 300
      },
      "cpu": "2048",
      "memory": "8192"
    },
    {
      "id": "qc",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/st-qc",
      "tag": "v0.1.0",
      "dependsOn": [
        "prep"
      ],
      "position": {
        "x": 560,
        "y": 300
      },
      "cpu": "2048",
      "memory": "16384",
      "inputs": [
        {
          "from": "prep",
          "output": "spatial",
          "input": "spatial"
        },
        {
          "from": "prep",
          "output": "metadata",
          "input": "metadata"
        }
      ]
    },
    {
      "id": "celltype",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/st-celltype",
      "tag": "v0.1.0",
      "dependsOn": [
        "qc",
        "prep"
      ],
      "position": {
        "x": 820,
        "y": 300
      },
      "cpu": "4096",
      "memory": "8192",
      "inputs": [
        {
          "from": "qc",
          "output": "spatial",
          "input": "spatial"
        },
        {
          "from": "prep",
          "output": "metadata",
          "input": "metadata"
        }
      ]
    },
    {
      "id": "niches",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/st-niches",
      "tag": "v0.1.0",
      "dependsOn": [
        "celltype",
        "qc",
        "prep"
      ],
      "position": {
        "x": 1080,
        "y": 170
      },
      "cpu": "2048",
      "memory": "6144",
      "inputs": [
        {
          "from": "qc",
          "output": "spatial",
          "input": "spatial"
        },
        {
          "from": "celltype",
          "output": "labels",
          "input": "labels"
        },
        {
          "from": "prep",
          "output": "metadata",
          "input": "metadata"
        }
      ],
      "defaultParams": {
        "LABEL_COLUMN": "cell_type",
        "LABEL": "cell-type"
      }
    },
    {
      "id": "ccc",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/st-ccc",
      "tag": "v0.1.0",
      "dependsOn": [
        "celltype",
        "qc",
        "prep"
      ],
      "position": {
        "x": 1080,
        "y": 430
      },
      "cpu": "2048",
      "memory": "6144",
      "inputs": [
        {
          "from": "qc",
          "output": "spatial",
          "input": "spatial"
        },
        {
          "from": "celltype",
          "output": "labels",
          "input": "labels"
        },
        {
          "from": "prep",
          "output": "metadata",
          "input": "metadata"
        }
      ],
      "defaultParams": {
        "LABEL_COLUMN": "cell_type",
        "LABEL": "cell-type"
      }
    },
    {
      "id": "report",
      "type": "processor",
      "sourceUrl": "https://github.com/pennsieve-apps/st-report",
      "tag": "v0.1.0",
      "dependsOn": [
        "prep",
        "qc",
        "celltype",
        "niches",
        "ccc"
      ],
      "position": {
        "x": 1340,
        "y": 300
      },
      "cpu": "1024",
      "memory": "2048",
      "inputs": [
        {
          "from": "prep",
          "output": "metadata",
          "input": "metadata"
        },
        {
          "from": "qc",
          "output": "qc",
          "input": "qc"
        },
        {
          "from": "celltype",
          "output": "labels",
          "input": "celltype"
        },
        {
          "from": "celltype",
          "output": "figures",
          "input": "celltype-figures"
        },
        {
          "from": "niches",
          "output": "niches",
          "input": "niches"
        },
        {
          "from": "ccc",
          "output": "ccc",
          "input": "ccc"
        }
      ],
      "defaultParams": {
        "REPORT_TITLE": "Single-cell Spatial Profiling"
      }
    }
  ],
  "outputs": [
    {
      "id": "report_out",
      "name": "Report",
      "from": {
        "step": "report",
        "output": "report"
      },
      "position": {
        "x": 1600,
        "y": 170
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/spatial-profiling/report"
        }
      }
    },
    {
      "id": "tables_out",
      "name": "Tables",
      "from": {
        "step": "report",
        "output": "tables"
      },
      "position": {
        "x": 1600,
        "y": 300
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/spatial-profiling/tables"
        }
      }
    },
    {
      "id": "celltype_out",
      "name": "Cell types",
      "from": {
        "step": "celltype",
        "output": "labels"
      },
      "position": {
        "x": 1600,
        "y": 430
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/spatial-profiling/cell-types"
        }
      }
    },
    {
      "id": "niches_out",
      "name": "Niches",
      "from": {
        "step": "niches",
        "output": "niches"
      },
      "position": {
        "x": 1600,
        "y": 560
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/spatial-profiling/niches"
        }
      }
    },
    {
      "id": "ccc_out",
      "name": "Cell-cell communication",
      "from": {
        "step": "ccc",
        "output": "ccc"
      },
      "position": {
        "x": 1600,
        "y": 690
      },
      "default": {
        "targetType": "Pennsieve Dataset",
        "params": {
          "TARGET_FOLDER": "derivatives/spatial-profiling/ccc"
        }
      }
    },
    {
      "id": "qc_spatial_out",
      "name": "QC'd AnnData",
      "from": {
        "step": "qc",
        "output": "spatial"
      },
      "position": {
        "x": 1600,
        "y": 820
      }
    }
  ]
}
